find_package(Python3 3.12 REQUIRED COMPONENTS Interpreter)
set(capstan_lease_default "${PROJECT_SOURCE_DIR}/../lease")
set(capstan_portal_default "${PROJECT_SOURCE_DIR}/../portal")
set(capstan_ff_default "${PROJECT_SOURCE_DIR}/../flux_foundry")
foreach(pair "lease;lease" "portal;portal" "ff;flux_foundry")
    list(GET pair 0 local_name)
    list(GET pair 1 dependency_name)
    if(NOT EXISTS "${capstan_${local_name}_default}/.git")
        set(capstan_${local_name}_default "${PROJECT_SOURCE_DIR}/build-deps/${dependency_name}")
    endif()
endforeach()
set(CAPSTAN_LEASE_SOURCE "${capstan_lease_default}" CACHE PATH "Local lease checkout (read only)")
set(CAPSTAN_PORTAL_SOURCE "${capstan_portal_default}" CACHE PATH "Local portal checkout (read only)")
set(CAPSTAN_FF_SOURCE "${capstan_ff_default}" CACHE PATH "Local flux_foundry checkout (read only)")
execute_process(COMMAND "${Python3_EXECUTABLE}" "${PROJECT_SOURCE_DIR}/scripts/snapshot_deps.py"
    --lock "${PROJECT_SOURCE_DIR}/deps.lock.json" --output "${PROJECT_BINARY_DIR}/_deps"
    --lease "${CAPSTAN_LEASE_SOURCE}" --portal "${CAPSTAN_PORTAL_SOURCE}" --flux_foundry "${CAPSTAN_FF_SOURCE}"
    RESULT_VARIABLE snapshot_result OUTPUT_VARIABLE snapshot_output ERROR_VARIABLE snapshot_error)
message(STATUS "${snapshot_output}")
if(NOT snapshot_result EQUAL 0)
    message(FATAL_ERROR "Locked dependency export failed: ${snapshot_error}")
endif()
set(LEASE_BUILD_TESTS OFF CACHE BOOL "" FORCE)
set(LEASE_BUILD_BENCH OFF CACHE BOOL "" FORCE)
set(PORTAL_BUILD_TESTS OFF CACHE BOOL "" FORCE)
set(PORTAL_BUILD_EXAMPLES OFF CACHE BOOL "" FORCE)
set(PORTAL_BUILD_BENCHMARKS OFF CACHE BOOL "" FORCE)
set(FLUX_FOUNDRY_BUILD_TESTS OFF CACHE BOOL "" FORCE)
foreach(dep lease portal flux_foundry)
    add_subdirectory("${PROJECT_BINARY_DIR}/_deps/${dep}" "${PROJECT_BINARY_DIR}/_deps/${dep}-build" EXCLUDE_FROM_ALL)
endforeach()
