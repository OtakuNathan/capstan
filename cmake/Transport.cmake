find_package(PkgConfig QUIET)
option(CAPSTAN_REQUIRE_GIO "Fail configuration when the TCP transport cannot be built" OFF)
if(PkgConfig_FOUND AND CMAKE_SYSTEM_NAME MATCHES "^(Linux|Darwin)$")
    pkg_check_modules(CAPSTAN_GIO QUIET IMPORTED_TARGET gio-2.0)
endif()
if(CAPSTAN_GIO_FOUND)
    add_library(capstan_gio STATIC src/transport/gio.cpp)
    target_link_libraries(capstan_gio PUBLIC capstan PkgConfig::CAPSTAN_GIO)
    set(CAPSTAN_SHA256_BACKEND "AUTO" CACHE STRING "Snapshot SHA-256: AUTO, OPENSSL or GLIB")
    set_property(CACHE CAPSTAN_SHA256_BACKEND PROPERTY STRINGS AUTO OPENSSL GLIB)
    if(NOT CAPSTAN_SHA256_BACKEND MATCHES "^(AUTO|OPENSSL|GLIB)$")
        message(FATAL_ERROR "CAPSTAN_SHA256_BACKEND must be AUTO, OPENSSL or GLIB")
    endif()
    if(NOT CAPSTAN_SHA256_BACKEND STREQUAL "GLIB")
        find_package(OpenSSL QUIET COMPONENTS Crypto)
    endif()
    if(NOT CAPSTAN_SHA256_BACKEND STREQUAL "GLIB" AND TARGET OpenSSL::Crypto)
        target_link_libraries(capstan_gio PUBLIC OpenSSL::Crypto)
        target_compile_definitions(capstan_gio PUBLIC CAPSTAN_OPENSSL_SHA256=1)
        set(CAPSTAN_SHA256_PROVIDER "OpenSSL" CACHE INTERNAL "Selected snapshot SHA-256 implementation" FORCE)
    elseif(CAPSTAN_SHA256_BACKEND STREQUAL "OPENSSL")
        message(FATAL_ERROR "OpenSSL Crypto development files are required for OPENSSL SHA-256")
    else()
        set(CAPSTAN_SHA256_PROVIDER "GLib" CACHE INTERNAL "Selected snapshot SHA-256 implementation" FORCE)
    endif()
    message(STATUS "Snapshot SHA-256 provider: ${CAPSTAN_SHA256_PROVIDER}")
    target_compile_options(capstan_gio PRIVATE -Wall -Wextra -Wpedantic)
    capstan_test(transport_test tests/integration/transport.cpp)
    target_link_libraries(transport_test PRIVATE capstan_gio)
else()
    if(CAPSTAN_REQUIRE_GIO)
        message(FATAL_ERROR "TCP benchmark requires Linux/macOS, pkg-config and GIO development files")
    endif()
    message(STATUS "GIO unavailable: TCP targets NOT BUILT; offline protocol tests remain available")
endif()
