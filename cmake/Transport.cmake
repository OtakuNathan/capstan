find_package(PkgConfig QUIET)
option(CAPSTAN_REQUIRE_GIO "Fail configuration when the TCP transport cannot be built" OFF)
if(PkgConfig_FOUND AND CMAKE_SYSTEM_NAME MATCHES "^(Linux|Darwin)$")
    pkg_check_modules(CAPSTAN_GIO QUIET IMPORTED_TARGET gio-2.0)
endif()
if(CAPSTAN_GIO_FOUND)
    add_library(capstan_gio STATIC src/transport/gio.cpp)
    target_link_libraries(capstan_gio PUBLIC capstan PkgConfig::CAPSTAN_GIO)
    target_compile_options(capstan_gio PRIVATE -Wall -Wextra -Wpedantic)
    capstan_test(transport_test tests/integration/transport.cpp)
    target_link_libraries(transport_test PRIVATE capstan_gio)
else()
    if(CAPSTAN_REQUIRE_GIO)
        message(FATAL_ERROR "TCP benchmark requires Linux/macOS, pkg-config and GIO development files")
    endif()
    message(STATUS "GIO unavailable: TCP targets NOT BUILT; offline protocol tests remain available")
endif()
